# انسخ الملف ده باسم .env وحط القيم الحقيقية (الملف .env مش بيترفع على GitHub)
# نفس المتغيرات دي لازم تبقى متضافة في Vercel > Settings > Environment Variables

# الداتا بيز (Supabase Postgres - رابط الـ pooler)
DATABASE_URL=""
# مفتاح تشفير جلسات الدخول
SECRET_KEY=""

# الصور (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# بوت التليجرام (الباك أب عند الطلب)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# الرقم السري لحذف فواتير الشراء
DELETE_PIN=""

# اختياري: باسوورد المدير العام لو /setup اتشغلت على داتا بيز فاضية
SETUP_GM_PASSWORD=""
